# MangoNews — SMTP credentials template.
# Copy this file to `.env` and fill in actual values. `.env` is gitignored.

# Google Workspace SMTP
MANGONEWS_SMTP_HOST=smtp.gmail.com
MANGONEWS_SMTP_PORT=587
MANGONEWS_SMTP_USER=woojin.juhn@mangoboost.io
MANGONEWS_SMTP_PASSWORD=

# From / To
MANGONEWS_FROM_EMAIL=woojin.juhn@mangoboost.io
MANGONEWS_FROM_NAME=MangoNews
MANGONEWS_TO_EMAILS=woojin.juhn@mangoboost.io
